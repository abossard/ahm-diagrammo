{
  "name": "ahm-diagrammo",
  "displayName": "AHM Diagrammo",
  "description": "AHM Health Model authoring for Draw.io Integration",
  "version": "0.1.0",
  "publisher": "abossard",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "extensionDependencies": [
    "hediet.vscode-drawio"
  ],
  "main": "./src/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "ahmDiagrammo.enable",
        "title": "Enable in Draw.io",
        "category": "AHM Diagrammo"
      },
      {
        "command": "ahmDiagrammo.disable",
        "title": "Disable in Draw.io",
        "category": "AHM Diagrammo"
      },
      {
        "command": "ahmDiagrammo.newModel",
        "title": "Create New AHM Health Model",
        "category": "AHM Diagrammo"
      },
      {
        "command": "ahmDiagrammo.showFingerprint",
        "title": "Show Plugin Fingerprint",
        "category": "AHM Diagrammo"
      }
    ]
  },
  "scripts": {
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "vscode-test",
    "sync-assets": "node scripts/sync-assets.mjs",
    "package": "node scripts/package-vsix.mjs",
    "test:installed": "node scripts/install-isolated.mjs",
    "author": "node scripts/author-from-blank.mjs"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0"
  }
}
