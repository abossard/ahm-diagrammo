{
  "name": "ahm-diagrammo",
  "version": "4.0.0",
  "description": "Turn the mermaid blocks in a Markdown file into themed static SVGs: Azure-portal style health-model swimlanes, Pele AHM signal tables, and every other Mermaid diagram via Pele",
  "type": "module",
  "license": "MIT",
  "bin": {
    "diagrammo": "bin/diagrammo.mjs",
    "ahm-diagrammo": "bin/diagrammo.mjs"
  },
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./styles.css": "./src/ahm.css"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "hero.md",
    "kitchen-sink.md",
    "pills-stress.md",
    "svg/hero.svg",
    "svg/kitchen-sink.svg",
    "svg/pills-stress.svg",
    "svg/pele/hero.svg",
    "svg/pele/kitchen-sink.svg",
    "svg/pele/pills-stress.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "azure-health-model",
    "health-model",
    "mermaid",
    "markdown",
    "swimlane",
    "pele",
    "svg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abossard/ahm-diagrammo.git"
  },
  "dependencies": {
    "pele": "1.6.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "fontkit": "^2.0.4",
    "marked": "15.0.12"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "goldens": "UPDATE_GOLDENS=1 node --test test/golden.test.mjs",
    "gallery": "node scripts/gallery.mjs",
    "gallery:check": "node scripts/gallery.mjs --check"
  }
}
